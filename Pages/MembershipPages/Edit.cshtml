@page
@model GitHubPractice.Pages.MembershipPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<div class="col mt-5">

    <div class="col-md-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-body p-4">

                <h3 class="text-black">
                    Edit
                </h3>
                <p>
                    <h4>Membership</h4>
                </p>
            </div>
        </div>
    </div>
</div>
<hr />
<div class="row">
    <div class="d-flex p-5 bg-white text-primary rounded-4 shadow-lg col-6 fw-bold">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Membership.Id" />
            <div class="form-group">
                <label asp-for="Membership.Name" class="control-label"></label>
                <input asp-for="Membership.Name" class="form-control" />
                <span asp-validation-for="Membership.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Membership.JoinDate" class="control-label"></label>
                <input asp-for="Membership.JoinDate" class="form-control" />
                <span asp-validation-for="Membership.JoinDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Membership.DateOfBirth" class="control-label"></label>
                <input asp-for="Membership.DateOfBirth" class="form-control" />
                <span asp-validation-for="Membership.DateOfBirth" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Membership.IsActive" class="control-label"></label>
                <input asp-for="Membership.IsActive" class="form-check-input" />
                <span asp-validation-for="Membership.IsActive" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
