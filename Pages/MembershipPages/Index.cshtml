@page
@model GitHubPractice.Pages.MembershipPages.IndexModel


@{
    ViewData["Title"] = "Index";
}
<div class="row mt-5">

    <div class="col-md-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-body p-4">

                <h3 class="text-black">
                    Memberships
                </h3>
                <p>
                    <a asp-page="Create" class="btn btn-primary btn-lg mt-3">Add New Membership</a>
                </p>
            </div>
        </div>
    </div>
</div>
<div class="d-flex flex-wrap gap-3 text-center p-5 bg-primary text-black rounded-4 shadow-lg justify-content-start">
@foreach (var item in Model.Membership) {
        <div class="d-flex flex-lg-column p-3 bg-light rounded-4">
            <p>
                Name: @Html.DisplayFor(model => item.Name)
            </p>
            <p>
                Join Date: @Html.DisplayFor(model => item.JoinDate)
            </p>
            <p>
                Date of Birth: @Html.DisplayFor(model => item.DateOfBirth)
            </p>
            <p>
                Active User: @Html.DisplayFor(model => item.IsActive)
            </p>
            <p>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> 
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> 
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </p>
        </div>
    }
</div>
